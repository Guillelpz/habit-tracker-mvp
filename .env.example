# Supabase (required for auth and database)
# Copy this file to ".env" in the project root and fill in your project values.
# Get URL and anon key: Supabase Dashboard → Project Settings → API
#
# Expo exposes variables prefixed with EXPO_PUBLIC_ to your app at build time.
# Never commit a real .env file.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
